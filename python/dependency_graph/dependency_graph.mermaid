---
config:
  layout: elk
---
graph BT
    subgraph python["python"]
        python___init__[__init__.py]
        python_call_graph[call_graph.py]
        python_extract[extract.py]
        python_render[render.py]
        python_server[server.py]
    end


    python_extract --> python_call_graph
    python_render --> python_call_graph
    python_extract --> python_server
    python_render --> python_server
    python_call_graph --> python_server

    classDef pythonDomain fill:#2a78d6,stroke:#184f95,color:#ffffff,stroke-width:1px;
    classDef boundary fill:#f5f5f5,stroke:#999999,color:#4d4d4d,stroke-width:1px;
    classDef broken fill:#d03b3b,stroke:#8a1f1f,stroke-dasharray: 2 2,color:#ffffff;
    classDef export fill:#4a3aa7,stroke:#2f2569,color:#ffffff,stroke-width:1px;

    class python___init__,python_call_graph,python_extract,python_render,python_server pythonDomain

    style python fill:#e9f1fa,stroke:#2a78d6,stroke-width:2px;
