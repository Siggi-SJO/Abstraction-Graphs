---
config:
  layout: elk
---
graph BT
    subgraph python["python"]
        subgraph python_call_graph["call_graph.py"]
            python_call_graph_fn_extract_call_graph(["extract_call_graph"])
            python_call_graph_fn_render_call_graph(["render_call_graph"])
            python_call_graph_fn_render_call_graph_html(["render_call_graph_html"])
            python_call_graph_fn_resolve_function_definition(["resolve_function_definition"])
            python_call_graph_fn_resolve_type_definition(["resolve_type_definition"])
        end
        subgraph python_extract["extract.py"]
            python_extract_fn_dotted_path(["dotted_path"])
            python_extract_fn_extract(["extract"])
            python_extract_fn_file_node_id(["file_node_id"])
            python_extract_fn_find_domains_in_tree(["find_domains_in_tree"])
            python_extract_fn_hash_files(["hash_files"])
            python_extract_fn_own_direct_files(["own_direct_files"])
            python_extract_fn_parse_imports(["parse_imports"])
            python_extract_fn_resolve_target(["resolve_target"])
            python_extract_fn_sibling_dotted(["sibling_dotted"])
        end
        subgraph python_render["render.py"]
            python_render_fn_build_forest(["build_forest"])
            python_render_fn_light_tint(["light_tint"])
            python_render_fn_render(["render"])
        end
        subgraph python_server["server.py"]
            python_server_fn_generate_dependency_graph(["generate_dependency_graph"])
            python_server_fn_generate_one(["generate_one"])
            python_server_fn_main(["main"])
        end
    end

    python_server_fn_generate_one <-->|calls / returns via _generate_dependency_graph| python_server_fn_main
    python_extract_fn_own_direct_files <-->|calls / returns via _generate_dependency_graph| python_server_fn_main
