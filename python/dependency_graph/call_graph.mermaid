    classDef pythonDomain fill:#2a78d6,stroke:#184f95,color:#ffffff,stroke-width:1px;
    classDef fileGroup fill:none,stroke:#999999,stroke-width:1px,stroke-dasharray: 2 2;

    class python pythonDomain
    class python_call_graph,python_extract,python_render,python_server fileGroup

    style python fill:#e9f1fa,stroke:#2a78d6,stroke-width:2px;

